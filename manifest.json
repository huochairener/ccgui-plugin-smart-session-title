{
  "id": "smart-session-title",
  "name": "智能会话命名",
  "version": "0.4.0",
  "minAppVersion": "1.1.0",
  "sdkVersion": "^0.3.14",
  "author": "huochairener",
  "repo": "huochairener/ccgui-plugin-smart-session-title",
  "license": "MIT",
  "icon": "docs/icon.svg",
  "keywords": ["title", "naming", "session", "emoji", "auto-title"],
  "description": "每轮对话结束后自动为会话生成带 emoji 前缀的简短标题：直调引擎 CLI 智能命名（默认跟随会话引擎，可固定引擎/模型，不落对话记录），失败回退本地关键词规则；状态栏显示进度与失败原因，附调试日志与右键重新命名。",
  "tier": "js",
  "permissions": [
    "events",
    "host:session",
    "exec:node",
    "exec:pi",
    "exec:omp",
    "exec:claude",
    "exec:codebuddy",
    "exec:codex",
    "storage",
    "plugin.storage",
    "ui:settings-section",
    "ui:session-menu",
    "ui:status-bar",
    "ui:command"
  ]
}
